# ---- Dependencies / build ----
node_modules/
build/
coverage/
.cache/
.phpunit.cache/

# ---- Secrets / credentials (NUNCA versionar) ----
*.local
config.local.*
secrets.*
*.key
*.pem
*.crt
*.p12
*.pfx
.env
.env.*
app-password*
credentials*
# A pasta de código Access/Policy/Credentials casa com credentials* no macOS (ignorecase).
!mcp/lib/Access/Policy/Credentials/
auth.json
tokens.json
mcp.json

# ---- Dados do usuário / cache de conteúdo (NUNCA versionar) ----
data/
cache/
tmp/
downloads/
*.sqlite
*.sqlite3
*.db
extracted/
attachments/
# O módulo Deck contém código, inclusive em volumes com ignorecase.
!mcp/lib/Modules/Deck/Attachments/
!mcp/lib/Modules/Talk/Attachments/

# ---- Logs ----
*.log
logs/
# O módulo de logs do app é código: no macOS (ignorecase) Logs/ casaria com logs/.
!mcp/lib/Modules/Logs/
!mcp/lib/Access/Logs/
!mcp/src/admin/logs/
!mcp/tests/Unit/Tools/Logs/

# ---- OS / editores ----
.DS_Store
Thumbs.db
