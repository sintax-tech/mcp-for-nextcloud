{
    "flow": "settings.logs-privacy",
    "steps": [
        {
            "step": "initial",
            "state": {
                "config": [],
                "appConfig": []
            }
        },
        {
            "step": "a string is refused: 400",
            "request": {
                "route": "logs_privacy#update",
                "user": "root",
                "body": {
                    "hideFileNames": "false"
                }
            },
            "response": {
                "status": 400,
                "json": {
                    "error": "Invalid request"
                }
            },
            "state": {
                "config": [],
                "appConfig": []
            }
        },
        {
            "step": "off",
            "request": {
                "route": "logs_privacy#update",
                "user": "root",
                "body": {
                    "hideFileNames": false
                }
            },
            "response": {
                "status": 200,
                "json": {
                    "hideFileNames": false,
                    "active": false
                }
            },
            "state": {
                "config": [],
                "appConfig": {
                    "mcp": {
                        "logs_hide_file_names": "0"
                    }
                }
            }
        },
        {
            "step": "on again",
            "request": {
                "route": "logs_privacy#update",
                "user": "root",
                "body": {
                    "hideFileNames": true
                }
            },
            "response": {
                "status": 200,
                "json": {
                    "hideFileNames": true,
                    "active": false
                }
            },
            "state": {
                "config": [],
                "appConfig": {
                    "mcp": {
                        "logs_hide_file_names": "1"
                    }
                }
            }
        }
    ]
}
